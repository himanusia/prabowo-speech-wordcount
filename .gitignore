# Virtualenv and Python caches
.venv/
__pycache__/
*.pyc

# Raw caption tracks are third-party material and never published.
# The repository ships source links plus derived counts instead.
data/*/raw/

# Transient fetch state: recreated by scripts/collect.py and friends.
data/*/manifest.json
data/*/discovery.json
data/*/panel-progress.jsonl
data/*/auto-resume-run.log
*.log

# Captures produced by the yt-dlp probes used during discovery.
data/*/ytdlp_subs/
